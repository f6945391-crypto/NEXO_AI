# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# API
PUERTO=3000

# Base de datos y cola (valores de docker-compose.yml). Puerto 5433 para no chocar
# con un PostgreSQL instalado en el equipo, que suele ocupar el 5432.
DATABASE_URL=postgresql://nexoai:nexoai@localhost:5433/nexoai
REDIS_URL=redis://localhost:6379

# Base que vacían y migran las pruebas. Su nombre tiene que terminar en _prueba.
DATABASE_URL_PRUEBA=postgresql://nexoai:nexoai@localhost:5433/nexoai_prueba

# Firma de los tokens de acceso (T-004). En .env, un valor aleatorio largo; nunca el de este ejemplo.
JWT_SECRETO=cambia-este-valor-por-uno-aleatorio-largo

# Google: ID de cliente OAuth de tipo «Aplicación web» (T-007). Los valores reales van solo en .env.
GOOGLE_CLIENT_ID=tu-id-de-cliente.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-secreto-de-cliente
GOOGLE_REDIRECT_URI=http://localhost:3000/integraciones/google/retorno

# Clave AES-256-GCM para cifrar los tokens de Google (T-007): 32 bytes en base64. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKENS_CLAVE_CIFRADO=
# A dónde vuelve el navegador tras conectar Google
WEB_URL=http://localhost:3001

# Orígenes de navegador que pueden llamar a la API (T-028), separados por comas. Una app nativa no los
# necesita; Expo web, sí. Nunca «*». Para probar el móvil en el navegador: http://localhost:3201
CORS_ORIGENES=http://localhost:3201

# Proveedor del modelo del asistente (T-029, specs/07-agente/plan.md §3). Por ahora, simulado:
#   no-configurado  el asistente no está disponible y todo lo pedido queda en espera (por defecto)
#   simulado           responde según un guion de frases conocidas, para demostrar sin clave; nunca en producción
#   compatible-openai  un proveedor con la API de chat de OpenAI: Groq, Cerebras, OpenRouter u Ollama (T-036)
MODELO_PROVEEDOR=no-configurado
# Solo con compatible-openai. Groq en su nivel gratuito, elegido para probar el 29 de octubre de 2026:
# MODELO_URL=https://api.groq.com/openai/v1
# MODELO_NOMBRE=openai/gpt-oss-120b
# La clave la crea el equipo en console.groq.com/keys y la escribe solo en .env, nunca aquí ni en el chat.
# MODELO_CLAVE=
# Dólares por millón de tokens de entrada y de salida; 0,0 en el nivel gratuito. Sin ella, costo desconocido.
# MODELO_PRECIOS=0,0
# Solo con OpenRouter (T-149): el orden de proveedores que se le pide, con respaldo a los demás. Por ejemplo:
# MODELO_PROVEEDORES=groq,cerebras

# Dictado por voz (T-154, REQ-CAP-27, plan de 07-agente §15). Sin definir, el dictado no está disponible:
#   no-configurado  «Hablar» avisa que el dictado no está disponible (por defecto)
#   simulado        devuelve un texto fijo, para pruebas y desarrollo; nunca en producción
#   openrouter      AssemblyAI Universal-3.6 Pro a través de OpenRouter, con la misma cuenta que el asistente
# DICTADO_PROVEEDOR=openrouter
# DICTADO_CLAVE=            (puede ser la misma clave de OpenRouter que MODELO_CLAVE)
# DICTADO_MODELO=assemblyai/universal-3-6-pro
# DICTADO_TERMINOS=NexoAI, Vasco, Aixa

# Correo de la plataforma (PT-3, T-122, specs/06-acceso/plan.md §5.8). Sin definir, es el simulado (en memoria).
# Desarrollo con Mailpit (docker compose up -d), correos en http://localhost:8025:
# CORREO_PROVEEDOR=smtp
# CORREO_SMTP_URL=smtp://localhost:1025
# CORREO_REMITENTE=NexoAI <no-responder@nexoenterprise.online>
# Envío real con Resend (dominio nexoenterprise.online verificado). La clave re_... solo en .env:
# CORREO_SMTP_URL=smtps://resend:re_TU_CLAVE@smtp.resend.com:465

# Detrás de un proxy inverso con HTTPS (producción, T-141, H-ACC-17): la IP del cliente sale de X-Forwarded-For.
# Sin esto, el límite de intentos sería uno solo para todos. En desarrollo, sin definir.
# CONFIAR_EN_PROXY=1

# La web habla con la API desde su servidor (Next.js). En desarrollo, http://localhost:3000; en contenedores,
# la dirección interna de la API (http://api:3000). El navegador nunca la usa.
# API_URL=

# El móvil (Expo) habla con la API directamente: en un teléfono, la IP del equipo o, en producción, la dirección
# pública de la API (https://api.nexoenterprise.online). Va en apps/movil/.env o en el entorno de Expo.
# EXPO_PUBLIC_API_URL=

# Producción: ver DESPLIEGUE.md. NODE_ENV=production rechaza el modelo, el calendario y el correo simulados.
