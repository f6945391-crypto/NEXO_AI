{
  "name": "@nexoai/api",
  "version": "0.0.0",
  "private": true,
  "description": "API de dominio de NexoAI (NestJS). Monolito modular, AD-01",
  "scripts": {
    "generar": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
