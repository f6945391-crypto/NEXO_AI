    "crear-cuenta": "node dist/cli/crear-cuenta.js",
    "probar-calendario": "node dist/cli/probar-calendario.js",
    "evaluar-asistente": "node dist/cli/evaluar-asistente.js"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@nexoai/contratos": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
