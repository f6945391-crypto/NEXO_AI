// Modelo de datos de NexoAI. Cada tabla cita su origen: entidad del Entregable 1 o tabla de sistema de un plan.
// Las migraciones viven en prisma/migrations y nunca se modifican una vez aplicadas (AGENTS.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generado/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// specs/06-acceso/plan.md §3
enum Rol {
  usuario_personal
  gerente
  // D-17: solo sus tareas asignadas, en el móvil (REQ-ACC-13)
  colaborador

  @@map("rol")
}

enum Plan {
  gratuito
  personal
  empresarial

  @@map("plan")
}

// Cliente que crea las cuentas (R-45). Tabla de sistema.
model Organizacion {
  id       String   @id @default(uuid()) @db.Uuid
  nombre   String
  creadaEn DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)

  perfiles         PerfilUsuario[]
  eventosAuditoria EventoAuditoria[]
  operaciones      Operacion[]
  consentimientos  ConsentimientoIntegracion[]
  eventosAgenda    EventoAgenda[]
  sincronizaciones SincronizacionCalendario[]

  @@map("organizacion")
}

// EN-01 Perfil de Usuario. Rol y plan los fija la organización (REQ-ACC-12).
model PerfilUsuario {
  id                    String   @id @default(uuid()) @db.Uuid
  organizacionId        String   @map("organizacion_id") @db.Uuid
  correo                String   @unique
  hashContrasena        String   @map("hash_contrasena")
  rol                   Rol
  plan                  Plan
  // IANA; nula hasta el primer ingreso (REQ-ACC-04)
  zonaHoraria           String?  @map("zona_horaria")
  debeCambiarContrasena Boolean  @default(true) @map("debe_cambiar_contrasena")
  creadoEn              DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  organizacion       Organizacion                @relation(fields: [organizacionId], references: [id])
  eventosAuditoria   EventoAuditoria[]
  sesionesRenovacion SesionRenovacion[]
  operaciones        Operacion[]
  consentimientos    ConsentimientoIntegracion[]
  eventosAgenda      EventoAgenda[]
  sincronizacion     SincronizacionCalendario?

  @@index([organizacionId])
  @@map("perfil_usuario")
}

// Token de renovación rotativo (specs/06-acceso/plan.md §3, T-004). Se guarda solo su hash.
// Todas las rotaciones de un mismo ingreso comparten `familia`: reutilizar un token ya rotado revoca la familia.
// No lleva organizacion_id: se consulta antes de conocer la organización, al renovar.
model SesionRenovacion {
  id         String    @id @default(uuid()) @db.Uuid
  perfilId   String    @map("perfil_id") @db.Uuid
  hashToken  String    @unique @map("hash_token")
  familia    String    @db.Uuid
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadaEn DateTime? @map("revocada_en") @db.Timestamptz(3)
  // T-024: solo se rellena cuando se revoca por rotación; habilita el margen de gracia (DP-04)
  rotadaEn   DateTime? @map("rotada_en") @db.Timestamptz(3)
  creadaEn   DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)

  perfil PerfilUsuario @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([familia])
  @@map("sesion_renovacion")
}

// Operación (AD-09, specs/02-agenda/plan.md §3) · T-012. Toda escritura con efecto se propone, se
// confirma y se ejecuta una sola vez. Su id es la clave de idempotencia; en_espera es la cola de P-11.
enum EstadoOperacion {
  en_espera
  propuesta
  ejecutada
  descartada
  fallida

  @@map("estado_operacion")
}

enum OrigenOperacion {
  agente
  control_directo

  @@map("origen_operacion")
}

model Operacion {
  id                String          @id @default(uuid()) @db.Uuid
  organizacionId    String          @map("organizacion_id") @db.Uuid
  perfilId          String          @map("perfil_id") @db.Uuid
  tipo              String
  origen            OrigenOperacion
  solicitudOriginal String?         @map("solicitud_original")
  carga             Json
  vistaConfirmacion Json            @map("vista_confirmacion")
  estado            EstadoOperacion
  resultado         Json?
  error             String?
  // Momento de la captura: referencia para resolver «mañana» en lo encolado (REQ-CAP-24)
  capturadaEn       DateTime        @default(now()) @map("capturada_en") @db.Timestamptz(3)
  creadaEn          DateTime        @default(now()) @map("creada_en") @db.Timestamptz(3)
  // Se rellena al reclamar la confirmación: solo una confirmación lo consigue
  confirmadaEn      DateTime?       @map("confirmada_en") @db.Timestamptz(3)
  ejecutadaEn       DateTime?       @map("ejecutada_en") @db.Timestamptz(3)

  organizacion Organizacion  @relation(fields: [organizacionId], references: [id])
  perfil       PerfilUsuario @relation(fields: [perfilId], references: [id])

  @@index([organizacionId, perfilId, estado])
  @@map("operacion")
}

// Permiso concedido a una integración externa (specs/06-acceso/plan.md §3) · T-007. Una fila por alcance:
// calendario y correo se conceden y se revocan por separado. El token se guarda cifrado (AES-256-GCM).
enum EstadoConsentimiento {
  concedido
  revocado
  caducado

  @@map("estado_consentimiento")
}

model ConsentimientoIntegracion {
  id             String               @id @default(uuid()) @db.Uuid
  organizacionId String               @map("organizacion_id") @db.Uuid
  perfilId       String               @map("perfil_id") @db.Uuid
  proveedor      String
  // Clave del alcance en packages/contratos: calendario · correo
  alcance        String
  estado         EstadoConsentimiento
  tokenCifrado   String?              @map("token_cifrado")
  concedidoEn    DateTime?            @map("concedido_en") @db.Timestamptz(3)
  cambiadoEn     DateTime             @default(now()) @updatedAt @map("cambiado_en") @db.Timestamptz(3)
  // REQ-ACC-09: el aviso de revocación se da una sola vez
  avisoEmitidoEn DateTime?            @map("aviso_emitido_en") @db.Timestamptz(3)

  organizacion Organizacion  @relation(fields: [organizacionId], references: [id])
  perfil       PerfilUsuario @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@unique([perfilId, proveedor, alcance])
  @@index([organizacionId])
  @@map("consentimiento_integracion")
}

// EN-02 Evento de Agenda, réplica del calendario de Google (AD-10, specs/02-agenda/plan.md §4) · T-014.
// Google es la fuente de verdad. Lo borrado allí se marca cancelado y no se borra de aquí (R-25).
enum EstadoEvento {
  confirmado
  cancelado

  @@map("estado_evento")
}

model EventoAgenda {
  id                 String       @id @default(uuid()) @db.Uuid
  organizacionId     String       @map("organizacion_id") @db.Uuid
  // RN-EST-01: cada evento corresponde a un perfil (REQ-CUN01-09)
  perfilId           String       @map("perfil_id") @db.Uuid
  // Solo el calendario principal (H-AG-06)
  googleCalendarioId String       @map("google_calendario_id")
  googleEventoId     String       @map("google_evento_id")
  etag               String
  titulo             String
  inicio             DateTime     @db.Timestamptz(3)
  fin                DateTime     @db.Timestamptz(3)
  // IANA del evento, tal como viene de Google (P-05, REQ-CUN01-10)
  zonaHoraria        String       @map("zona_horaria")
  // H-AG-03: se muestran, pero no cuentan como conflicto
  todoElDia          Boolean      @map("todo_el_dia")
  // H-AG-05
  esOrganizador      Boolean      @map("es_organizador")
  // Instancia de un evento recurrente (H-AG-04)
  serieId            String?      @map("serie_id")
  estado             EstadoEvento
  sincronizadoEn     DateTime     @map("sincronizado_en") @db.Timestamptz(3)

  organizacion Organizacion  @relation(fields: [organizacionId], references: [id])
  perfil       PerfilUsuario @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@unique([perfilId, googleEventoId])
  @@index([perfilId, inicio, fin])
  @@index([organizacionId])
  @@map("evento_agenda")
}

// Estado de la sincronización con Google de cada perfil (specs/02-agenda/plan.md §4) · T-014.
model SincronizacionCalendario {
  perfilId             String   @id @map("perfil_id") @db.Uuid
  organizacionId       String   @map("organizacion_id") @db.Uuid
  // Para la lectura incremental; nulo obliga a leer desde cero
  syncToken            String?  @map("sync_token")
  ventanaDesde         DateTime @map("ventana_desde") @db.Timestamptz(3)
  ventanaHasta         DateTime @map("ventana_hasta") @db.Timestamptz(3)
  ultimaSincronizacion DateTime @map("ultima_sincronizacion") @db.Timestamptz(3)

  organizacion Organizacion  @relation(fields: [organizacionId], references: [id])
  perfil       PerfilUsuario @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
  @@map("sincronizacion_calendario")
}

// Registro de acciones (propuesta técnica §9). Tabla de sistema.
model EventoAuditoria {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  perfilId       String?  @map("perfil_id") @db.Uuid
  accion         String
  detalle        Json     @default("{}")
  ocurridoEn     DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(3)

  organizacion Organizacion   @relation(fields: [organizacionId], references: [id])
  perfil       PerfilUsuario? @relation(fields: [perfilId], references: [id])

  @@index([organizacionId, ocurridoEn])
  @@map("evento_auditoria")
}
