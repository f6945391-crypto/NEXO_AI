{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_nota": "Los valores de modo Oscuro no están cargados en Figma: el plan Starter limita a un modo por colección. Al activar el plan educativo (Professional), añadir el modo Oscuro y cargar la columna correspondiente.",
  "color": {
    "marca": {
      "base":   { "$type": "color", "$value": "#2166B0", "$extensions": { "oscuro": "#4E96DE" } },
      "fuerte": { "$type": "color", "$value": "#17497E", "$extensions": { "oscuro": "#7FB4E8" } },
      "suave":  { "$type": "color", "$value": "#E8F1FA", "$extensions": { "oscuro": "#16283A" } }
    },
    "superficie": {
      "base":    { "$type": "color", "$value": "#FFFFFF", "$extensions": { "oscuro": "#0F1419" } },
      "elevada": { "$type": "color", "$value": "#F7FAFC", "$extensions": { "oscuro": "#1A2129" } },
      "hundida": { "$type": "color", "$value": "#EDF2F6", "$extensions": { "oscuro": "#0A0E12" } }
    },
    "texto": {
      "fuerte":  { "$type": "color", "$value": "#14212E", "$extensions": { "oscuro": "#E8EEF2" } },
      "suave":   { "$type": "color", "$value": "#5A6E7A", "$extensions": { "oscuro": "#93A4AE" } },
      "inverso": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "oscuro": "#0F1419" } }
    },
    "borde": {
      "base":   { "$type": "color", "$value": "#DCE6EC", "$extensions": { "oscuro": "#2A3540" } },
      "fuerte": { "$type": "color", "$value": "#B8C9D4", "$extensions": { "oscuro": "#3D4B57" } }
    },
    "agente": {
      "base":  { "$type": "color", "$value": "#6B4FD8", "$extensions": { "oscuro": "#9B85EC" } },
      "suave": { "$type": "color", "$value": "#F0ECFD", "$extensions": { "oscuro": "#221B3D" } }
    },
    "estado": {
      "exito":             { "$type": "color", "$value": "#1B7F4B", "$extensions": { "oscuro": "#4CAF7D" } },
      "exito-suave":       { "$type": "color", "$value": "#E6F4EC", "$extensions": { "oscuro": "#12291E" } },
      "advertencia":       { "$type": "color", "$value": "#9A6400", "$extensions": { "oscuro": "#D9A036" } },
      "advertencia-suave": { "$type": "color", "$value": "#FDF3E0", "$extensions": { "oscuro": "#2A2110" } },
      "error":             { "$type": "color", "$value": "#B3261E", "$extensions": { "oscuro": "#E8756C" } },
      "error-suave":       { "$type": "color", "$value": "#FBEAE9", "$extensions": { "oscuro": "#2E1614" } }
    }
  },
  "espaciado": {
    "2":  { "$type": "dimension", "$value": "2px" },
    "4":  { "$type": "dimension", "$value": "4px" },
    "8":  { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "20": { "$type": "dimension", "$value": "20px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "40": { "$type": "dimension", "$value": "40px" },
    "48": { "$type": "dimension", "$value": "48px" }
  },
  "radio": {
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "tipografia": {
    "titulo":        { "$type": "dimension", "$value": "28px" },
    "subtitulo":     { "$type": "dimension", "$value": "22px" },
    "cuerpo-grande": { "$type": "dimension", "$value": "18px" },
    "cuerpo":        { "$type": "dimension", "$value": "16px" },
    "etiqueta":      { "$type": "dimension", "$value": "14px" },
    "micro":         { "$type": "dimension", "$value": "12px" }
  },
  "_contraste": {
    "_nota": "Calculado contra superficie/base en modo Claro (#FFFFFF). Mínimo exigido 4.5:1.",
    "texto/fuerte": "15.1:1",
    "texto/suave": "4.95:1",
    "marca/base": "5.83:1",
    "agente/base": "5.62:1",
    "estado/exito": "5.02:1",
    "estado/advertencia": "5.00:1",
    "estado/error": "6.54:1"
  }
}
